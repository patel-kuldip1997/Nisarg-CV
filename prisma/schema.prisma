generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password         String
  email            String?  @unique
  profileImage     String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Profile {
  id             Int      @id @default(autoincrement())
  name           String   @default("Kuldipkumar Patel")
  primaryTitle   String   @default("Senior Technical Support Engineer")
  secondaryTitle String   @default("Application Support • Cloud • DevOps • Full-Stack")
  introduction   String   @db.Text
  aboutSummary   String   @db.Text
  yearsOfExp     String   @default("6+")
  technologies   String   @default("30+")
  issuesResolved String   @default("1000+")
  supportLevel   String   @default("24/7")
  resumeUrl      String?
  profileImage   String?
  githubUrl      String?
  linkedinUrl    String?
  email          String?
  heroBadges     String   @default("[]") @db.Text
  updatedAt      DateTime @updatedAt
}

model Experience {
  id             Int      @id @default(autoincrement())
  company        String
  position       String
  location       String?
  startDate      String
  endDate        String   @default("Present")
  description    String   @db.Text // Bullet points or text
  technologies   String   // Comma separated
  achievements   String?  @db.Text
  order          Int      @default(0)
  createdAt      DateTime @default(now())
}

model SkillCategory {
  id        Int      @id @default(autoincrement())
  name      String
  order     Int      @default(0)
  skills    Skill[]
}

model Skill {
  id              Int            @id @default(autoincrement())
  name            String
  level           Int            @default(80) // 1-100
  categoryId      Int
  category        SkillCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  relatedProjects String?        // For hover states
  technologies    String?        // Detailed tech used
  icon            String?        // SVG or Image URL for the skill
  order           Int            @default(0)
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String
  category     String   @default("All") // e.g. Full Stack, React, DevOps
  shortDesc    String   @db.Text
  problem      String?  @db.Text
  solution     String?  @db.Text
  architecture String?  @db.Text
  challenges   String?  @db.Text
  results      String?  @db.Text
  technologies String   // Comma separated
  imageUrl     String?
  githubUrl    String?
  liveUrl      String?
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Education {
  id           Int      @id @default(autoincrement())
  institution  String
  degree       String
  startDate    String
  endDate      String
  description  String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon        String   @default("code") // Lucide icon name
  order       Int      @default(0)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  company   String
  content   String   @db.Text
  avatarUrl String?
  order     Int      @default(0)
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ThemeSettings {
  id                  Int      @id @default(autoincrement())
  primaryColor        String   @default("#3b82f6")
  secondaryColor      String   @default("#8b5cf6")
  backgroundColor     String   @default("#050505")
  accentColor         String   @default("#10b981")
  fontFamily          String   @default("Inter")
  backgroundAnimation String   @default("mesh")
  enableParallax      Boolean  @default(true)
  cardStyle           String   @default("glassmorphism")
  borderRadius        String   @default("8px")
  buttonStyle         String   @default("filled")
  navbarStyle         String   @default("floating")
  cursorStyle         String   @default("default")
  layoutWidth         String   @default("max-w-7xl")
  glowIntensity       String   @default("medium")
  textReveal          String   @default("fade")
  sectionSpacing      String   @default("normal")
  shadowStyle         String   @default("soft")
  borderWidth         String   @default("1px")
  backdropBlur        String   @default("md")
  pageTransition      String   @default("fade")
  imageStyle          String   @default("rounded")
  activeMasterTheme   String   @default("glass")
  
  // --- SITE IDENTITY ---
  siteTitle           String   @default("My Portfolio")
  logoType            String   @default("text") // "text" or "image"
  logoText            String   @default("KP.")
  logoImageUrl        String?
  faviconUrl          String?

  // --- EXTENDED COLORS (5) ---
  successColor        String   @default("#22c55e")
  warningColor        String   @default("#f59e0b")
  errorColor          String   @default("#ef4444")
  infoColor           String   @default("#3b82f6")
  surfaceColor        String   @default("#0a0a0a")

  // --- ADVANCED TYPOGRAPHY (5) ---
  headingFontWeight   String   @default("bold")
  bodyFontWeight      String   @default("normal")
  letterSpacing       String   @default("normal")
  lineHeight          String   @default("relaxed")
  textTransform       String   @default("none")

  // --- BUTTON ARCHITECTURE (5) ---
  buttonPadding       String   @default("normal")
  buttonHoverEffect   String   @default("lift")
  buttonIconPosition  String   @default("right")
  buttonAnimation     String   @default("pulse")
  buttonShadow        String   @default("none")

  // --- NAVIGATION ENGINE (5) ---
  navbarHeight        String   @default("normal")
  navbarBlurIntensity String   @default("md")
  navbarHoverEffect   String   @default("glow")
  navbarDropdownStyle String   @default("modern")
  logoSize            String   @default("normal")

  // --- CARD ENGINE (5) ---
  cardPadding         String   @default("normal")
  cardHoverLift       String   @default("medium")
  cardImageRatio      String   @default("video")
  cardBorderAccent    String   @default("none")
  cardGlowIntensity   String   @default("none")

  // --- FOOTER & LAYOUT (3) ---
  footerStyle         String   @default("modern")
  footerColumns       String   @default("4")
  contentAlignment    String   @default("left")

  // --- MOTION DYNAMICS (2) ---
  scrollBehavior      String   @default("smooth")
  parallaxDepth       String   @default("medium")

  // --- PAGE BUILDER ---
  sectionOrder        String   @default("hero,about,experience,skills,projects,education,contact") @db.Text
  skillLayout         String   @default("design1")
  
  updatedAt           DateTime @updatedAt
}

model CustomSection {
  id          Int      @id @default(autoincrement())
  sectionId   String   @unique
  title       String
  subtitle    String?
  layout      String   @default("full-text") // full-text, split-view, grid
  content     String   @db.Text // JSON string of blocks
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
